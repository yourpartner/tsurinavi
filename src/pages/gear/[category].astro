---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { gearCategories, getGearCategoryBySlug } from '../../data/gear';

export async function getStaticPaths() {
  return gearCategories.map(g => ({ params: { category: g.slug } }));
}

const { category: slug } = Astro.params;
const gear = getGearCategoryBySlug(slug);
if (!gear) return Astro.redirect('/');
---

<BaseLayout
  title={`${gear.name}おすすめランキング【${new Date().getFullYear()}年版】| TsuriNavi`}
  description={`${gear.name}のおすすめ商品を厳選紹介。${gear.description}。Amazon・楽天で購入できる人気アイテムをランキング形式で掲載。`}
  type="article"
>
  <Header slot="header" />

  <main class="max-w-4xl mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-ocean-600">トップ</a>
      <span>›</span>
      <span class="text-gray-500">装備ガイド</span>
      <span>›</span>
      <span class="text-gray-800 font-medium">{gear.name}</span>
    </nav>

    <!-- Header -->
    <div class="bg-gradient-to-r from-ocean-700 to-teal-600 rounded-2xl p-8 text-white mb-10">
      <div class="flex items-center gap-3 mb-2">
        <span class="bg-white/20 text-white text-xs font-medium px-2.5 py-1 rounded-full">{gear.scene}</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-black mb-2">{gear.name}</h1>
      <p class="text-ocean-200">{gear.description}</p>
    </div>

    <!-- Affiliate Disclosure -->
    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4 mb-8 text-sm text-yellow-800">
      <strong>アフィリエイト表示：</strong>
      当ページのAmazon・楽天市場リンクはアフィリエイトリンクです。ご購入いただくと当サイトの運営費用に充当されます。
      掲載商品の選定は当サイト独自の基準で行っており、スポンサーの影響を受けておりません。
    </div>

    <!-- Items List -->
    <div class="space-y-6">
      {gear.items.map((item, i) => (
        <div class={`bg-white rounded-2xl shadow-sm border-2 overflow-hidden ${item.recommended ? 'border-ocean-300' : 'border-gray-100'}`}>
          {item.recommended && (
            <div class="bg-ocean-600 px-4 py-2 flex items-center gap-2">
              <span class="text-yellow-300 font-bold text-sm">★ おすすめ</span>
              <span class="text-white text-xs">編集部ピックアップ</span>
            </div>
          )}
          <div class="p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-2">
                  <span class="w-7 h-7 bg-ocean-100 text-ocean-700 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">
                    {i + 1}
                  </span>
                  <h2 class="font-bold text-gray-900 text-lg">{item.name}</h2>
                </div>
                <p class="text-gray-600 text-sm leading-relaxed mb-3 ml-10">{item.description}</p>
                <div class="ml-10">
                  <span class="text-sm text-gray-500">目安価格：</span>
                  <span class="text-sm font-semibold text-gray-800">{item.priceRange}</span>
                </div>
              </div>
              <div class="flex flex-col gap-2 flex-shrink-0">
                <a
                  href={item.amazonLink}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 text-sm font-bold rounded-xl transition-colors whitespace-nowrap"
                >
                  Amazonで見る
                </a>
                <a
                  href={item.rakutenLink}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="inline-flex items-center gap-2 px-5 py-2.5 bg-red-500 hover:bg-red-600 text-white text-sm font-bold rounded-xl transition-colors whitespace-nowrap"
                >
                  楽天で見る
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Other Categories -->
    <div class="mt-12 bg-ocean-50 rounded-2xl p-8">
      <h2 class="text-xl font-bold text-gray-900 mb-4">他の装備ガイド</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {gearCategories.filter(g => g.slug !== gear.slug).map(g => (
          <a
            href={`/gear/${g.slug}`}
            class="bg-white rounded-xl p-4 hover:border-ocean-300 border border-gray-100 hover:shadow-sm transition-all text-center"
          >
            <p class="font-semibold text-gray-800 text-sm mb-1">{g.name}</p>
            <p class="text-xs text-gray-500">{g.scene}</p>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
