---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { methods, getMethodBySlug } from '../../data/methods';

export async function getStaticPaths() {
  return methods.map(m => ({ params: { method: m.slug } }));
}

const { method: slug } = Astro.params;
const method = getMethodBySlug(slug);
if (!method) return Astro.redirect('/');

const diffLabel = ['', '初心者向け', '中級者向け', '上級者向け'];
const diffColor = ['', 'bg-green-100 text-green-700 border-green-200', 'bg-yellow-100 text-yellow-700 border-yellow-200', 'bg-red-100 text-red-700 border-red-200'];

const budgetColor = { '低': 'text-green-700', '中': 'text-yellow-700', '高': 'text-red-700' };
---

<BaseLayout
  title={`${method.name}の始め方・仕掛け解説【初心者向けガイド】| TsuriNavi`}
  description={`${method.name}を徹底解説。必要な道具・仕掛け・コツ・おすすめスポットまで詳しく紹介。${method.targetFish.join('・')}を狙う釣り方です。`}
  type="article"
>
  <Header slot="header" />

  <main class="max-w-5xl mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-ocean-600">トップ</a>
      <span>›</span>
      <span class="text-gray-500">釣り方ガイド</span>
      <span>›</span>
      <span class="text-gray-800 font-medium">{method.name}</span>
    </nav>

    <!-- Method Header -->
    <div class="bg-gradient-to-r from-teal-700 to-ocean-700 rounded-2xl p-8 text-white mb-10">
      <div class="flex flex-col md:flex-row items-start justify-between gap-4">
        <div>
          <h1 class="text-4xl font-black mb-3">{method.name}</h1>
          <div class="flex flex-wrap items-center gap-2 mb-4">
            {method.beginner && (
              <span class="bg-green-400 text-green-900 text-sm px-3 py-1.5 rounded-full font-bold">
                ✅ 初心者でも始めやすい
              </span>
            )}
            <span class={`text-sm px-3 py-1.5 rounded-full border font-medium ${diffColor[method.difficulty]}`}>
              {diffLabel[method.difficulty]}
            </span>
            <span class="bg-white/20 text-white text-sm px-3 py-1.5 rounded-full">
              初期費用: <span class={`font-bold ${budgetColor[method.gearBudget]}`}>{method.gearBudget}</span>
            </span>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {method.scene.map(s => (
              <span class="bg-white/10 border border-white/20 text-white text-xs px-2.5 py-1 rounded-full">{s}</span>
            ))}
          </div>
        </div>
        <a
          href={method.amazonLink}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-3 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 font-bold rounded-xl transition-colors"
        >
          Amazon で道具を探す
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">
        <!-- Description -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">{method.name}とは？</h2>
          <p class="text-gray-700 leading-relaxed text-base">{method.description}</p>
        </div>

        <!-- Target Fish -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">🎯 主なターゲット魚種</h2>
          <div class="flex flex-wrap gap-2 mb-4">
            {method.targetFish.map(fish => (
              <span class="bg-ocean-50 text-ocean-700 text-sm px-4 py-2 rounded-full border border-ocean-100 font-medium">
                {fish}
              </span>
            ))}
          </div>
        </div>

        <!-- Recommended Gear -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">🎒 おすすめ道具・仕掛け</h2>
          <p class="text-gray-600 mb-6 leading-relaxed">
            {method.name}に必要な道具はまとめてセット購入するのが入門者には便利です。
            下記のリンクから各ECサイトで最新のおすすめ商品をご確認ください。
          </p>
          <div class="flex gap-3 flex-wrap">
            <a
              href={method.amazonLink}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-2 px-5 py-3 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 font-bold rounded-xl transition-colors"
            >
              Amazon でセットを探す
            </a>
            <a
              href={method.rakutenLink}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-2 px-5 py-3 bg-red-500 hover:bg-red-600 text-white font-bold rounded-xl transition-colors"
            >
              楽天市場で探す
            </a>
          </div>
          <p class="text-xs text-gray-400 mt-3">
            ※上記リンクはAmazonアソシエイト・楽天アフィリエイトプログラムを利用しています。
          </p>
        </div>

        <!-- Beginner Tips -->
        {method.beginner && (
          <div class="bg-green-50 border border-green-200 rounded-2xl p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-4">
              🌟 初心者が{method.name}を始めるには？
            </h2>
            <ol class="space-y-4">
              {[
                `釣具店やAmazonで「${method.name}入門セット」を購入。まずは道具を揃えましょう。`,
                `釣り場（堤防・港）を決め、当日の潮汐と天気を確認。TsuriNavi で事前チェック！`,
                `現地でコマセ（アミエビ）など消耗品を購入し、仕掛けをセット。`,
                `釣れなくても焦らず、コマセを定期的に補充しながら待ちましょう。`,
                `釣れた魚はクーラーボックスで持ち帰り。新鮮なうちに食べましょう！`,
              ].map((tip, i) => (
                <li class="flex items-start gap-3">
                  <span class="flex-shrink-0 w-6 h-6 bg-green-500 text-white text-xs font-bold rounded-full flex items-center justify-center mt-0.5">
                    {i + 1}
                  </span>
                  <p class="text-gray-700 text-sm leading-relaxed">{tip}</p>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Quick Info -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h3 class="font-bold text-gray-900 mb-4">基本情報</h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-xs text-gray-500 mb-0.5">難易度</dt>
              <dd>
                <span class={`text-sm font-medium px-2.5 py-1 rounded-full border ${diffColor[method.difficulty]}`}>
                  {diffLabel[method.difficulty]}
                </span>
              </dd>
            </div>
            <div>
              <dt class="text-xs text-gray-500 mb-0.5">初期費用の目安</dt>
              <dd class={`text-sm font-bold ${budgetColor[method.gearBudget]}`}>
                {method.gearBudget === '低' ? '〜5,000円' : method.gearBudget === '中' ? '10,000〜30,000円' : '30,000円〜'}
              </dd>
            </div>
            <div>
              <dt class="text-xs text-gray-500 mb-1">釣り場</dt>
              <dd class="flex flex-wrap gap-1">
                {method.scene.map(s => (
                  <span class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded">{s}</span>
                ))}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Other Methods -->
        <div class="bg-ocean-50 rounded-2xl p-6">
          <h3 class="font-bold text-gray-800 mb-3 text-sm">他の釣り方を見る</h3>
          <ul class="space-y-2">
            {methods.filter(m => m.slug !== method.slug).map(m => (
              <li>
                <a href={`/method/${m.slug}`} class="text-sm text-ocean-700 hover:underline flex items-center gap-1.5">
                  <span>→</span> {m.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
