---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SpotCard from '../../components/SpotCard.astro';
import { fishList, getFishBySlug } from '../../data/fish';
import { getSpotBySlug } from '../../data/spots';

export async function getStaticPaths() {
  return fishList.map(f => ({ params: { name: f.slug } }));
}

const { name: slug } = Astro.params;
const fish = getFishBySlug(slug);
if (!fish) return Astro.redirect('/');

const relatedSpots = fish.spots.map(s => getSpotBySlug(s)).filter(Boolean);

const diffLabel = ['', '初心者向け', '中級者向け', '上級者向け'];
const diffColor = ['', 'bg-green-100 text-green-700', 'bg-yellow-100 text-yellow-700', 'bg-red-100 text-red-700'];

const amazonGearLink = `https://www.amazon.co.jp/s?k=${encodeURIComponent(fish.name + ' 釣り 仕掛け おすすめ')}&tag=YOURTAG-22`;
const rakutenGearLink = `https://search.rakuten.co.jp/search/mall/${encodeURIComponent(fish.name + ' 釣り 仕掛け')}/`;
---

<BaseLayout
  title={`${fish.name}の釣り方・仕掛け・おすすめ装備 | TsuriNavi 釣りナビ`}
  description={`${fish.name}（${fish.nameEn}）の釣り方を完全解説。シーズン・釣り方・仕掛け・装備おすすめを詳しく紹介。${fish.season}が主な釣れる時期です。`}
  type="article"
>
  <Header slot="header" />

  <main class="max-w-5xl mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
      <a href="/" class="hover:text-ocean-600">トップ</a>
      <span>›</span>
      <span class="text-gray-500">魚種ガイド</span>
      <span>›</span>
      <span class="text-gray-800 font-medium">{fish.name}</span>
    </nav>

    <!-- Fish Header -->
    <div class="bg-gradient-to-r from-ocean-800 to-teal-700 rounded-2xl p-8 text-white mb-10">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="text-4xl font-black mb-1">{fish.name}</h1>
          <p class="text-ocean-200 text-lg mb-3">{fish.nameEn}</p>
          <div class="flex flex-wrap items-center gap-2">
            <span class={`text-sm px-3 py-1.5 rounded-full font-medium ${diffColor[fish.difficulty]}`}>
              {diffLabel[fish.difficulty]}
            </span>
            <span class="bg-white/20 text-white text-sm px-3 py-1.5 rounded-full">
              🗓️ {fish.season}
            </span>
          </div>
        </div>
        <div class="text-right">
          <div class="flex gap-2">
            <a
              href={amazonGearLink}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 text-sm font-bold rounded-xl transition-colors"
            >
              Amazon で装備を見る
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-8">
        <!-- Description -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">🐟 {fish.name}について</h2>
          <p class="text-gray-700 leading-relaxed text-base">{fish.description}</p>
        </div>

        <!-- Methods -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">🎣 主な釣り方</h2>
          <div class="flex flex-wrap gap-2 mb-6">
            {fish.methods.map(m => (
              <span class="bg-ocean-50 text-ocean-700 text-sm px-4 py-2 rounded-full border border-ocean-100 font-medium">
                {m}
              </span>
            ))}
          </div>
          <p class="text-sm text-gray-500">
            釣り方の詳細は
            <a href="/method/sabiki" class="text-ocean-600 hover:underline">釣り方入門ガイド</a>
            をご参照ください。
          </p>
        </div>

        <!-- Gear -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
          <h2 class="text-xl font-bold text-gray-900 mb-4">🎒 必要な装備・仕掛け</h2>
          <ul class="space-y-3 mb-6">
            {fish.gear.map(g => (
              <li class="flex items-start gap-3 text-gray-700">
                <span class="w-1.5 h-1.5 bg-ocean-500 rounded-full mt-2 flex-shrink-0"></span>
                <span>{g}</span>
              </li>
            ))}
          </ul>
          <div class="flex gap-3 flex-wrap">
            <a
              href={amazonGearLink}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 font-bold rounded-xl transition-colors text-sm"
            >
              Amazon で{fish.name}の仕掛けを探す
            </a>
            <a
              href={rakutenGearLink}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-2 px-5 py-2.5 bg-red-500 hover:bg-red-600 text-white font-bold rounded-xl transition-colors text-sm"
            >
              楽天市場で探す
            </a>
          </div>
          <p class="text-xs text-gray-400 mt-3">
            ※上記リンクはAmazonアソシエイト・楽天アフィリエイトプログラムを利用しています。
          </p>
        </div>

        <!-- Related Spots -->
        {relatedSpots.length > 0 && (
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4">
              📍 {fish.name}が釣れる代表的なスポット
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {relatedSpots.map(spot => spot && <SpotCard spot={spot} showScore={true} />)}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="space-y-6">
        <!-- Quick Facts -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h3 class="font-bold text-gray-900 mb-4">基本情報</h3>
          <dl class="space-y-3">
            <div>
              <dt class="text-xs text-gray-500 mb-0.5">釣れる時期</dt>
              <dd class="text-sm font-medium text-gray-800">{fish.season}</dd>
            </div>
            <div>
              <dt class="text-xs text-gray-500 mb-0.5">難易度</dt>
              <dd>
                <span class={`text-sm font-medium px-2.5 py-1 rounded-full ${diffColor[fish.difficulty]}`}>
                  {diffLabel[fish.difficulty]}
                </span>
              </dd>
            </div>
            <div>
              <dt class="text-xs text-gray-500 mb-1">主な釣り方</dt>
              <dd class="flex flex-wrap gap-1.5">
                {fish.methods.map(m => (
                  <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded">{m}</span>
                ))}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Other Fish -->
        <div class="bg-ocean-50 rounded-2xl p-6">
          <h3 class="font-bold text-gray-800 mb-3 text-sm">他の魚種ガイド</h3>
          <ul class="space-y-2">
            {fishList.filter(f => f.slug !== fish.slug).slice(0, 6).map(f => (
              <li>
                <a href={`/fish/${f.slug}`} class="text-sm text-ocean-700 hover:underline flex items-center gap-1.5">
                  <span>→</span> {f.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>
