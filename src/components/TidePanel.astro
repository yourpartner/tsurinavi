---
import type { TideData, WeatherData } from '../data/spots';

export interface Props {
  tide: TideData;
  weather: WeatherData;
  spotName: string;
}

const { tide, weather, spotName } = Astro.props;

const tideTypeColor: Record<TideData['type'], string> = {
  '大潮': 'bg-blue-600 text-white',
  '中潮': 'bg-blue-400 text-white',
  '小潮': 'bg-sky-300 text-sky-900',
  '長潮': 'bg-gray-300 text-gray-700',
  '若潮': 'bg-teal-300 text-teal-900',
};

const today = new Date().toLocaleDateString('ja-JP', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long',
});
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
  <!-- Header -->
  <div class="bg-gradient-to-r from-ocean-700 to-ocean-600 px-6 py-4">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-white font-bold text-lg">今日のコンディション</h2>
        <p class="text-ocean-200 text-sm mt-0.5">{today}</p>
      </div>
      <span class={`px-3 py-1.5 rounded-lg font-bold text-sm ${tideTypeColor[tide.type]}`}>
        {tide.type}
      </span>
    </div>
  </div>

  <div class="p-6">
    <!-- Tide Times Grid -->
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div class="bg-blue-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-blue-600 mb-2 flex items-center gap-1">
          <span>🔼</span> 満潮
        </p>
        {tide.highTide.map(t => (
          <div class="flex items-baseline gap-2">
            <span class="text-lg font-bold text-blue-800">{t.time}</span>
            <span class="text-sm text-blue-600">{t.height}cm</span>
          </div>
        ))}
      </div>
      <div class="bg-amber-50 rounded-xl p-4">
        <p class="text-xs font-semibold text-amber-600 mb-2 flex items-center gap-1">
          <span>🔽</span> 干潮
        </p>
        {tide.lowTide.map(t => (
          <div class="flex items-baseline gap-2">
            <span class="text-lg font-bold text-amber-800">{t.time}</span>
            <span class="text-sm text-amber-600">{t.height}cm</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Weather Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-gray-50 rounded-xl p-3 text-center">
        <p class="text-xs text-gray-500 mb-1">天気</p>
        <p class="font-bold text-gray-800 text-sm leading-tight">{weather.condition}</p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 text-center">
        <p class="text-xs text-gray-500 mb-1">気温</p>
        <p class="font-bold text-gray-800">
          {weather.temp}<span class="text-xs font-normal text-gray-500">°C</span>
        </p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 text-center">
        <p class="text-xs text-gray-500 mb-1">風速</p>
        <p class={`font-bold ${weather.windSpeed > 8 ? 'text-red-600' : weather.windSpeed > 5 ? 'text-yellow-600' : 'text-gray-800'}`}>
          {weather.windSpeed}<span class="text-xs font-normal text-gray-500">m/s</span>
        </p>
        <p class="text-xs text-gray-500">{weather.windDir}</p>
      </div>
      <div class="bg-gray-50 rounded-xl p-3 text-center">
        <p class="text-xs text-gray-500 mb-1">降水確率</p>
        <p class={`font-bold ${weather.precipitation >= 50 ? 'text-blue-600' : 'text-gray-800'}`}>
          {weather.precipitation}<span class="text-xs font-normal text-gray-500">%</span>
        </p>
      </div>
    </div>

    <!-- Optional: Wave & Water Temp -->
    {(weather.waveHeight != null || weather.waterTemp != null) && (
      <div class="grid grid-cols-2 gap-3 mt-3">
        {weather.waveHeight != null && (
          <div class="bg-ocean-50 rounded-xl p-3 text-center">
            <p class="text-xs text-ocean-600 mb-1">波高</p>
            <p class={`font-bold ${weather.waveHeight > 1.5 ? 'text-red-600' : 'text-ocean-800'}`}>
              {weather.waveHeight}<span class="text-xs font-normal text-ocean-600">m</span>
            </p>
          </div>
        )}
        {weather.waterTemp != null && (
          <div class="bg-teal-50 rounded-xl p-3 text-center">
            <p class="text-xs text-teal-600 mb-1">水温</p>
            <p class="font-bold text-teal-800">
              {weather.waterTemp}<span class="text-xs font-normal text-teal-600">°C</span>
            </p>
          </div>
        )}
      </div>
    )}

    <!-- Moon Age -->
    <p class="text-xs text-gray-400 mt-4 text-right">
      月齢 {tide.moonAge}日 ／ 
      データ更新: {new Date().toLocaleString('ja-JP', { timeZone: 'Asia/Tokyo', hour: '2-digit', minute: '2-digit' })}
    </p>
  </div>
</div>
