---
import type { AiAdvice } from '../data/spots';

export interface Props {
  advice: AiAdvice;
}

const { advice } = Astro.props;

const overallColor = {
  '✅ 好条件':    'border-green-400 bg-green-50',
  '⚠️ 注意が必要': 'border-yellow-400 bg-yellow-50',
  '❌ 不向き':   'border-red-400 bg-red-50',
};

const overallBadge = {
  '✅ 好条件':    'bg-green-500 text-white',
  '⚠️ 注意が必要': 'bg-yellow-500 text-white',
  '❌ 不向き':   'bg-red-500 text-white',
};
---

<div class={`rounded-2xl border-2 overflow-hidden ${overallColor[advice.overall]}`}>
  <!-- Header -->
  <div class="px-6 py-4 flex items-center justify-between border-b border-black/5">
    <div>
      <h2 class="font-bold text-gray-900 text-lg flex items-center gap-2">
        <span>🤖</span>
        <span>AIによる今日の釣行アドバイス</span>
      </h2>
      <p class="text-xs text-gray-500 mt-0.5">更新: {advice.updatedAt}</p>
    </div>
    <span class={`px-4 py-2 rounded-xl text-sm font-bold ${overallBadge[advice.overall]}`}>
      {advice.overall}
    </span>
  </div>

  <div class="p-6 space-y-5">
    <!-- Summary -->
    <div class="bg-white/70 rounded-xl p-4">
      <p class="text-gray-800 leading-relaxed">{advice.summary}</p>
    </div>

    <!-- Best Time -->
    <div class="flex items-start gap-3">
      <span class="text-xl flex-shrink-0">⏰</span>
      <div>
        <p class="text-xs font-semibold text-gray-500 mb-0.5">おすすめの時間帯</p>
        <p class="text-sm font-medium text-gray-800">{advice.bestTime}</p>
      </div>
    </div>

    <!-- Recommended Fish -->
    <div class="flex items-start gap-3">
      <span class="text-xl flex-shrink-0">🐟</span>
      <div>
        <p class="text-xs font-semibold text-gray-500 mb-1.5">今日のおすすめターゲット</p>
        <div class="flex flex-wrap gap-2">
          {advice.recommendedFish.map(fish => (
            <span class="bg-white border border-gray-200 text-gray-700 text-sm px-3 py-1 rounded-full font-medium">
              {fish}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Reasons -->
    <div>
      <p class="text-xs font-semibold text-gray-500 mb-2">コンディション評価の根拠</p>
      <ul class="space-y-1.5">
        {advice.reasons.map(r => (
          <li class="flex items-start gap-2 text-sm text-gray-700">
            <span class="text-gray-400 mt-0.5">•</span>
            <span>{r}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Caution -->
    {advice.caution && (
      <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-3 text-sm text-yellow-800">
        {advice.caution}
      </div>
    )}

    <!-- Safety -->
    <div class="bg-red-50 border border-red-200 rounded-xl p-4 text-sm text-red-800">
      {advice.safety}
    </div>

    <p class="text-xs text-gray-400 text-right">
      ※本アドバイスは気象・潮汐データに基づくAI推定です。釣果を保証するものではありません。
    </p>
  </div>
</div>
