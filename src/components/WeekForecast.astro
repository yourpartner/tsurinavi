---
import type { WeekForecastDay } from '../data/spots';

export interface Props {
  forecast: WeekForecastDay[];
}

const { forecast } = Astro.props;

const weatherIcon: Record<string, string> = {
  '晴れ': '☀️',
  '晴れ時々曇り': '🌤️',
  '曇り時々晴れ': '⛅',
  '曇り': '☁️',
  '小雨': '🌧️',
  '雨': '🌧️',
  '大雨': '⛈️',
};

function scoreClass(score: number): string {
  if (score >= 80) return 'bg-green-500';
  if (score >= 60) return 'bg-yellow-400';
  return 'bg-red-400';
}

const tideColor: Record<string, string> = {
  '大潮': 'text-blue-700 font-bold',
  '中潮': 'text-blue-500',
  '小潮': 'text-gray-500',
  '長潮': 'text-gray-400',
  '若潮': 'text-teal-500',
};
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100">
    <h2 class="font-bold text-gray-900 text-lg">7日間の釣り予報</h2>
    <p class="text-sm text-gray-500 mt-0.5">潮汐・天気・釣りスコアの予測</p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50 text-xs text-gray-500 border-b border-gray-100">
          <th class="text-left px-4 py-2.5 font-medium">日付</th>
          <th class="text-center px-3 py-2.5 font-medium">潮</th>
          <th class="text-center px-3 py-2.5 font-medium">天気</th>
          <th class="text-center px-3 py-2.5 font-medium">風速</th>
          <th class="text-center px-3 py-2.5 font-medium">降水</th>
          <th class="text-center px-4 py-2.5 font-medium">釣りスコア</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        {forecast.map((day, i) => (
          <tr class={`${i === 0 ? 'bg-ocean-50' : 'hover:bg-gray-50'} transition-colors`}>
            <td class="px-4 py-3">
              <div class="flex items-center gap-2">
                {i === 0 && <span class="text-xs bg-ocean-600 text-white px-1.5 py-0.5 rounded font-medium">今日</span>}
                <span class="font-medium text-sm text-gray-800">{day.date}</span>
                <span class={`text-xs ${day.dayOfWeek === '土' ? 'text-blue-600' : day.dayOfWeek === '日' ? 'text-red-500' : 'text-gray-500'}`}>
                  ({day.dayOfWeek})
                </span>
              </div>
            </td>
            <td class="px-3 py-3 text-center">
              <span class={`text-xs font-medium ${tideColor[day.tideType] ?? 'text-gray-600'}`}>
                {day.tideType}
              </span>
            </td>
            <td class="px-3 py-3 text-center">
              <span class="text-lg" title={day.weather}>
                {weatherIcon[day.weather] ?? '🌡️'}
              </span>
            </td>
            <td class="px-3 py-3 text-center">
              <span class={`text-sm font-medium ${day.windSpeed > 8 ? 'text-red-600' : day.windSpeed > 5 ? 'text-yellow-600' : 'text-gray-700'}`}>
                {day.windSpeed}m/s
              </span>
            </td>
            <td class="px-3 py-3 text-center">
              <span class={`text-sm ${day.precipitation >= 50 ? 'text-blue-600 font-medium' : 'text-gray-600'}`}>
                {day.precipitation}%
              </span>
            </td>
            <td class="px-4 py-3 text-center">
              <div class="flex items-center justify-center gap-1.5">
                <div class={`w-2 h-2 rounded-full ${scoreClass(day.score)}`}></div>
                <span class="text-sm font-bold text-gray-800">{day.score}</span>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="px-6 py-3 bg-gray-50 text-xs text-gray-400 flex items-center gap-4">
    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>80以上：好条件</span>
    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-yellow-400 inline-block"></span>60〜79：まずまず</span>
    <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400 inline-block"></span>60未満：不向き</span>
  </div>
</div>
