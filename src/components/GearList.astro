---
export interface GearItem {
  label: string;
  spec: string;
  amazonLink: string;
  rakutenLink?: string;
}

export interface GearScene {
  name: string;
  icon: string;
  items: GearItem[];
}

export interface Props {
  scenes: GearScene[];
}

const { scenes } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-100">
    <h2 class="font-bold text-gray-900 text-lg flex items-center gap-2">
      <span>🎒</span>
      <span>おすすめ装備リスト</span>
    </h2>
    <p class="text-xs text-gray-500 mt-0.5">
      ※Amazonアソシエイト・楽天アフィリエイトプログラム参加中。商品リンクから購入すると当サイトの運営に役立てられます。
    </p>
  </div>

  <div class="divide-y divide-gray-50">
    {scenes.map(scene => (
      <div class="p-6">
        <h3 class="flex items-center gap-2 font-semibold text-gray-800 mb-4">
          <span class="text-xl">{scene.icon}</span>
          <span>{scene.name}</span>
        </h3>
        <div class="space-y-3">
          {scene.items.map(item => (
            <div class="flex items-start justify-between gap-4 bg-gray-50 rounded-xl p-4">
              <div class="flex-1 min-w-0">
                <p class="font-medium text-gray-800 text-sm">{item.label}</p>
                <p class="text-xs text-gray-500 mt-0.5 leading-relaxed">{item.spec}</p>
              </div>
              <div class="flex flex-col gap-1.5 flex-shrink-0">
                <a
                  href={item.amazonLink}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-yellow-400 hover:bg-yellow-500 text-yellow-900 text-xs font-bold rounded-lg transition-colors whitespace-nowrap"
                >
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><path d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.606 8.447-1.816a32.776 32.776 0 0 0 1.8-.906c.16-.097.28-.112.36-.045.08.067.063.2-.056.396l-.278.354c-.613.773-1.38 1.46-2.298 2.062-.917.6-1.944 1.053-3.078 1.355-1.134.302-2.32.453-3.556.453-2.617 0-5.156-.631-7.612-1.89-2.455-1.26-4.504-2.977-6.144-5.151-.157-.207-.192-.343-.056-.407zm3.08-2.11c-.146-.12-.15-.25-.01-.375 1.06-.953 2.195-1.44 3.41-1.46.35-.007.697.033 1.038.122.34.09.68.23 1.014.42.336.19.677.42 1.022.69.346.272.698.576 1.054.91a.374.374 0 0 0 .28.107c.096 0 .19-.022.28-.067a.374.374 0 0 0 .184-.32v-.014a27.003 27.003 0 0 0-.056-1.764 24.56 24.56 0 0 0-.167-1.748.255.255 0 0 1 .044-.207.258.258 0 0 1 .179-.1c.063-.007.127 0 .19.02.063.022.12.056.17.102.383.35.793.712 1.227 1.084a44.99 44.99 0 0 0 1.354 1.08c.47.36.977.71 1.522 1.046s1.128.647 1.748.936c.62.29 1.273.528 1.96.715.688.187 1.41.28 2.167.28.338 0 .67-.018.993-.055a.39.39 0 0 1 .307.074.39.39 0 0 1 .138.29.37.37 0 0 1-.09.254.37.37 0 0 1-.24.12 12.42 12.42 0 0 1-1.108.047c-.733 0-1.46-.082-2.175-.247a14.553 14.553 0 0 1-2.05-.678 17.05 17.05 0 0 1-1.915-1.062 35.028 35.028 0 0 1-1.778-1.396c-.567-.476-1.12-.972-1.654-1.487a21.68 21.68 0 0 1 .045 1.005c.007.337.007.674 0 1.01v.025a.62.62 0 0 1-.29.527.62.62 0 0 1-.605.033 27.67 27.67 0 0 1-1.197-1.016 22.1 22.1 0 0 0-1.09-.896 12.72 12.72 0 0 0-1.11-.75 8.15 8.15 0 0 0-1.2-.542 5.52 5.52 0 0 0-1.346-.235 5.46 5.46 0 0 0-1.387.1c-.46.1-.91.267-1.35.504a6.99 6.99 0 0 0-1.254.876l-.056.054z"/></svg>
                  Amazon
                </a>
                {item.rakutenLink && (
                  <a
                    href={item.rakutenLink}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white text-xs font-bold rounded-lg transition-colors whitespace-nowrap"
                  >
                    楽天市場
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
