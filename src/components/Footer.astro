---
const currentYear = new Date().getFullYear();
---

<footer class="bg-ocean-900 text-ocean-200 mt-16">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-3">
          <span class="text-2xl">🎣</span>
          <div>
            <span class="block text-xl font-black text-white">TsuriNavi</span>
            <span class="block text-xs text-ocean-400">釣りナビ</span>
          </div>
        </a>
        <p class="text-sm text-ocean-400 leading-relaxed">
          潮汐・天気・水温・AI釣果建議を統合した<br/>
          日本最大の釣りコンディション情報サービス
        </p>
        <div class="flex gap-3 mt-4">
          <a href="https://twitter.com/tsurinavi_jp" class="text-ocean-400 hover:text-white transition-colors" aria-label="X (Twitter)">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="text-ocean-400 hover:text-white transition-colors" aria-label="LINE公式アカウント">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          </a>
        </div>
      </div>

      <!-- Links: Spots -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm">人気エリア</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/area/chiba"     class="hover:text-white transition-colors">千葉県の釣りスポット</a></li>
          <li><a href="/area/kanagawa" class="hover:text-white transition-colors">神奈川県の釣りスポット</a></li>
          <li><a href="/area/shizuoka" class="hover:text-white transition-colors">静岡県の釣りスポット</a></li>
          <li><a href="/area/tokyo"    class="hover:text-white transition-colors">東京都の釣りスポット</a></li>
          <li><a href="/area/osaka"    class="hover:text-white transition-colors">大阪府の釣りスポット</a></li>
        </ul>
      </div>

      <!-- Links: Info -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm">釣り情報</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/fish/aji"        class="hover:text-white transition-colors">アジの釣り方</a></li>
          <li><a href="/fish/seabass"    class="hover:text-white transition-colors">シーバスの釣り方</a></li>
          <li><a href="/method/sabiki"   class="hover:text-white transition-colors">サビキ釣り入門</a></li>
          <li><a href="/method/eging"    class="hover:text-white transition-colors">エギング入門</a></li>
          <li><a href="/gear/safety"     class="hover:text-white transition-colors">釣りの安全装備</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-white font-semibold mb-3 text-sm">サイト情報</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/legal/operator"   class="hover:text-white transition-colors">運営者情報</a></li>
          <li><a href="/legal/privacy"    class="hover:text-white transition-colors">プライバシーポリシー</a></li>
          <li><a href="/legal/disclaimer" class="hover:text-white transition-colors">免責事項</a></li>
          <li><a href="/legal/affiliate"  class="hover:text-white transition-colors">アフィリエイト表示</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-ocean-800 mt-10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-ocean-500">
      <p>© {currentYear} TsuriNavi 釣りナビ. All rights reserved.</p>
      <p class="text-center">
        本サイトはAmazonアソシエイト・楽天アフィリエイトプログラムに参加しています。<br class="sm:hidden"/>
        掲載の釣果・条件はあくまで参考情報です。実際の釣行は現地の状況を必ずご確認ください。
      </p>
    </div>
  </div>
</footer>
