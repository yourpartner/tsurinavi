# ────────────────────────────────────────────────
# TsuriNavi 環境変数テンプレート
# このファイルをコピーして .env を作成してください
# cp .env.example .env
# ────────────────────────────────────────────────

# ──── 潮汐データ ────
# 海しるAPI（海上保安庁）APIキー
# 取得方法: https://www.msil.go.jp/ で無料登録
# ※ 未設定の場合は天文計算による近似値を使用（精度±30分程度）
UMINARU_API_KEY=

# ──── AI文章生成 ────
# DeepSeek API キー (ルールベース生成から高品質な日本語AIアドバイスへアップグレード)
# 取得方法: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ──── デプロイ ────
# Cloudflare Pages デプロイ用 (GitHub Actionsで使用)
# GitHub リポジトリ Settings > Secrets and variables > Actions で設定
# CLOUDFLARE_API_TOKEN=      (Cloudflare ダッシュボード > マイプロフィール > APIトークン)
# CLOUDFLARE_ACCOUNT_ID=     (Cloudflare ダッシュボード右側に表示)

# ──── 通知 ────
# Telegram Bot (毎日のデプロイ成功/失敗通知)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ──── 将来的な拡張 ────
# Amazon アソシエイト ID (現在はリンクに直接記載)
# AMAZON_ASSOCIATE_TAG=YOURTAG-22
